<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Hlibz.Redoc.Extensions</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Implies IsTrimmable. Only a claim about this assembly: the host serializes the theme
         config with a reflection resolver chained in, so a real NativeAOT host still won't run
         it. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="NuGet metadata">
    <PackageId>Hlibz.Redoc.Extensions.Swashbuckle</PackageId>
    <Authors>Hlib Zinchenko</Authors>
    <Description>Add-ons for Swashbuckle.AspNetCore.ReDoc's ReDoc UI middleware: a drop-in dark theme with an optional Light/System/Dark switcher and accent color customization, plus a document picker that serves multiple OpenAPI documents as ReDoc pages with a dropdown to switch between them, like Swagger UI's definition selector.</Description>
    <Title>ReDoc dark theme and document picker for Swashbuckle</Title>
    <PackageTags>redoc;redoc-dark-theme;openapi;openapi-ui;swagger;swashbuckle;swashbuckle.aspnetcore;aspnetcore;dark-theme;dark-mode;api-docs;documentation;multiple-documents</PackageTags>
    <PackageProjectUrl>https://github.com/hlib-zinchenko/Hlibz.Redoc.AspNetCore.Extensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hlib-zinchenko/Hlibz.Redoc.AspNetCore.Extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.ReDoc" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hlibz.Redoc.Extensions.Core\Hlibz.Redoc.Extensions.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
