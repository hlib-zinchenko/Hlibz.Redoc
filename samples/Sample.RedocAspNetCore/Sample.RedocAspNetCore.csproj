<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Native AddOpenApi()/MapOpenApi() needs net9.0+; the library itself still targets net8.0,
         which demonstrates it works fine when referenced from a newer host app. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sample.RedocAspNetCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hlibz.Redoc.Extensions.RedocAspNetCore\Hlibz.Redoc.Extensions.RedocAspNetCore.csproj" />
  </ItemGroup>

</Project>
