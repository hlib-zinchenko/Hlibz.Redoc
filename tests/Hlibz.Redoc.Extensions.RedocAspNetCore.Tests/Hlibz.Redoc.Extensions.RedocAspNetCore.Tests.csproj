<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The document-name check resolves the OpenAPI providers' internal IDocumentProvider by
         type name, so the tests exercise the real packages rather than a stand-in. AddOpenApi
         needs net9.0+. On net10.0 the library under test is its net8.0 assembly; on net11.0 it
         is its own net11.0 one, against Microsoft.AspNetCore.OpenApi 11. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hlibz.Redoc.Extensions.RedocAspNetCore\Hlibz.Redoc.Extensions.RedocAspNetCore.csproj" />
  </ItemGroup>

  <!-- One set of assertions, compiled once per adapter. See ConformanceHost.cs. -->
  <ItemGroup>
    <Compile Include="..\Conformance\*.cs" Link="Conformance\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
