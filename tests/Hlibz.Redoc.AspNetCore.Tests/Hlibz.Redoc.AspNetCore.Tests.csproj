<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The document-name check resolves the OpenAPI provider's internal IDocumentProvider by
         type name, so the tests exercise the real package rather than a stand-in. AddOpenApi
         needs net9.0+. The library under test is still its net8.0 assembly. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hlibz.Redoc.AspNetCore\Hlibz.Redoc.AspNetCore.csproj" />
  </ItemGroup>

  <!-- The bundle's provenance note, so a test can hold the table in it against the bundle it
       describes. Embedded rather than read off disk: the test then needs no path to the repository
       and runs the same wherever the assembly is. It is not embedded in the package itself. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\Hlibz.Redoc.AspNetCore\assets\README.md"
                      LogicalName="assets-README.md" />
  </ItemGroup>

</Project>
